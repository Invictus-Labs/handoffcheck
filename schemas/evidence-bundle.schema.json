{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-bundle.schema.json",
  "title": "Evidence bundle header (bundle.json) and run export (run.json)",
  "description": "A bundle is a single ustar archive: bundle.json (first), run.json, objects/<sha256>... No symlinks, no other paths. The header lists every file with its sha256 and size; root_hash is sha256 over newline-joined '<path>:<sha256>' sorted by path.",
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "schema_version", "created_at", "producer", "run_id", "binding_digest", "files", "root_hash", "metadata_bytes", "blob_bytes"],
      "properties": {
        "format": { "const": "handoffcheck-evidence-bundle" },
        "format_version": { "const": 1 },
        "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
        "created_at": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": { "name": { "const": "handoffcheck" }, "version": { "type": "string", "maxLength": 64 } }
        },
        "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "binding_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": { "type": "string", "pattern": "^(run\\.json|objects/[0-9a-f]{64})$" },
              "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
              "size_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "root_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "metadata_bytes": { "type": "integer", "minimum": 0 },
        "blob_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "verdict_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "steps_and_cleanup_pass", "independent", "exit_code", "reasons", "human_receipt", "binding_check"],
      "properties": {
        "verdict": { "$ref": "common.schema.json#/$defs/verdict" },
        "steps_and_cleanup_pass": { "type": "boolean" },
        "independent": { "type": "boolean" },
        "exit_code": { "enum": [0, 1] },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": { "code": { "$ref": "common.schema.json#/$defs/reason_code" }, "message": { "$ref": "common.schema.json#/$defs/text" } }
          }
        },
        "human_receipt": { "enum": ["PENDING_HUMAN_RECEIPT", "HARNESS_RECORDED"] },
        "binding_check": { "enum": ["MATCH", "MISMATCH", "NOT_CHECKED"] }
      }
    },
    "run_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "exported_at", "drill", "state_history", "steps", "interventions", "evidence", "cleanup_receipts", "verdict"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
        "exported_at": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
        "drill": { "$ref": "drill.schema.json" },
        "state_history": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "from_state", "to_state", "reason", "at"],
            "properties": {
              "seq": { "type": "integer", "minimum": 0 },
              "from_state": { "oneOf": [{ "$ref": "common.schema.json#/$defs/run_state" }, { "type": "null" }] },
              "to_state": { "$ref": "common.schema.json#/$defs/run_state" },
              "reason": { "type": ["string", "null"], "maxLength": 1000 },
              "at": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
            }
          }
        },
        "steps": { "type": "array", "maxItems": 50, "items": { "$ref": "step.schema.json#/$defs/step_record" } },
        "interventions": { "type": "array", "maxItems": 1000, "items": { "$ref": "intervention.schema.json" } },
        "evidence": { "type": "array", "maxItems": 990, "items": { "$ref": "evidence.schema.json" } },
        "cleanup_receipts": { "type": "array", "maxItems": 100, "items": { "$ref": "cleanup-receipt.schema.json" } },
        "verdict": { "$ref": "#/$defs/verdict_snapshot" }
      }
    }
  },
  "$ref": "#/$defs/header"
}
