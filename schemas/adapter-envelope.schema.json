{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-envelope.schema.json",
  "title": "Optional ecosystem adapter envelope (local files only, disabled by default)",
  "description": "Consumers dedupe on event_id, reject unsupported major schema versions, preserve revision/ordering metadata and never infer current state from an old event. Delivery is at least once. No network.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "source", "resource_id", "event_type", "occurred_at", "revision", "evidence_ref"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "type": "string", "minLength": 1, "maxLength": 64 },
    "resource_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
    "revision": { "type": "integer", "minimum": 0 },
    "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
